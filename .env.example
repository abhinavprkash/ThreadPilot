# Required - Slack Bot Tokens
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Required - AWS Credentials for Amazon Bedrock
# Get credentials from AWS Console or IAM
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Optional - Amazon Bedrock model configuration
# Amazon Nova Micro (cheapest, fast, great for summarization)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Other options:
# amazon.nova-lite-v1:0                      (slightly more capable, still cheap)
# anthropic.claude-3-haiku-20240307-v1:0     (Anthropic, higher quality)
# anthropic.claude-3-5-sonnet-20241022-v2:0  (Anthropic, best quality)
BEDROCK_REGION=us-east-1
TEMPERATURE=0.7

# Optional - LangChain/LangSmith tracing
LANGCHAIN_API_KEY=your-langchain-key-here
LANGCHAIN_PROJECT=Threadbrief
LANGCHAIN_TRACING_V2=true

# Channel IDs (replace with your actual channel IDs)
CHANNEL_MECHANICAL=C0A5HE4MY3U
CHANNEL_ELECTRICAL=C0A5M2C539A
CHANNEL_SOFTWARE=C0A5FD731PY

# Digest distribution settings
CHANNEL_DIGEST=C0123456789  # Channel where the main digest is posted
LEADERSHIP_USERS=U0123456789,U9876543210  # Comma-separated user IDs for leadership DMs

# DM Bot settings (optional)
# DM_SEND_TO_ALL=false  # Set to true to send DMs to all workspace users
# DM_RATE_LIMIT_DELAY=1.0  # Delay in seconds between DMs (respect rate limits)
